# ============================
# Database
# ============================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=dsa_revision_tracker

# ============================
# Auth
# ============================
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=dsa_token

# ============================
# AI (Gemini)
# ============================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ============================
# App
# ============================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
